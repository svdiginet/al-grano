{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"(async()=>{const root=process.env.CLAUDE_PLUGIN_ROOT||process.env.PLUGIN_ROOT;if(root)await import(require('node:url').pathToFileURL(require('node:path').join(root,'hooks','al-grano-activate.mjs')).href)})().catch(()=>{})\"",
            "timeout": 30,
            "statusMessage": "Loading al-grano mode..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"(async()=>{const root=process.env.CLAUDE_PLUGIN_ROOT||process.env.PLUGIN_ROOT;if(root)await import(require('node:url').pathToFileURL(require('node:path').join(root,'hooks','al-grano-tracker.mjs')).href)})().catch(()=>{})\"",
            "timeout": 10,
            "statusMessage": "Tracking al-grano mode..."
          }
        ]
      }
    ]
  }
}
